{
  "name": "xwing-data2-legacy",
  "version": "3.10.0",
  "repository": "git@github.com:SogeMoge/xwing-data2-legacy.git",
  "author": "Guido Kessels <mail@guidokessels.com>",
  "maintainer": "Artem Kropachev @SogeMoge",
  "license": "MIT",
  "scripts": {
    "test": "jest tests",
    "validate:json": "node scripts/validate-json.js",
    "validate:tests": "jest tests",
    "validate:tests:watch": "jest --watch tests",
    "format": "prettier --loglevel warn --write \"data/**/*.json\"",
    "changelog": "git log --pretty=format:'- %s (%h)' --no-merges"
  },
  "devDependencies": {
    "@types/node": "^17.0.21",
    "git-diff": "^2.0.6",
    "husky": "^4.2.1",
    "jest": "^29.3.1",
    "jest-json-schema": "^2.1.0",
    "json-stable-stringify": "^1.0.1",
    "jsonfile": "^5.0.0",
    "lint-staged": "^10.0.7",
    "node-fetch": "^3.1.1",
    "prettier": "^1.19.1",
    "ts-node": "^10.5.0",
    "typescript": "^4.5.5"
  },
  "lint-staged": {
    "*.{js,json}": [
      "prettier --write"
    ],
    "{data,tests}/**/*.{js,json}": [
      "npm run validate:tests -- --bail"
    ],
    "*.json": "prettier --write"
  },
  "prettier": {
    "tabWidth": 2,
    "printWidth": 80
  }
}